APP_NAME="HanViet API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# MySQL local (recommended)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hanviet
DB_USERNAME=root
DB_PASSWORD=

# SQLite fallback (no MySQL needed)
# DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

FRONTEND_URL=http://localhost:8080

# OpenAI — AI Tutor + Whisper speech (optional in dev)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Google AdSense (miễn phí) — xem docs/ADS-SETUP.md
ADS_ENABLED=false
ADSENSE_CLIENT_ID=
ADSENSE_VERIFICATION=
ADSENSE_AUTO_ADS=true
ADSENSE_SLOT_BANNER=
ADSENSE_SLOT_VOCAB=
ADSENSE_SLOT_QUIZ=

# Google OAuth — đăng nhập bằng Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Premium: sandbox = kích hoạt ngay (mặc định), live = Momo/VNPay
PREMIUM_PAYMENT_MODE=sandbox

# SEO — Google Analytics 4 (tùy chọn, hợp pháp qua Google)
GOOGLE_ANALYTICS_ID=
# HANVIET_OG_IMAGE_URL=https://your-domain.com/og/share.svg

# DB_CONNECTION=pgsql
# DATABASE_URL=postgres://...

VITE_APP_NAME="${APP_NAME}"
